# ------------------------------------------------------------------
# Integração com a API do Claude (Anthropic) — copie para `.env`
# ------------------------------------------------------------------
# Variáveis EXPO_PUBLIC_* são injetadas no bundle pelo Expo em tempo de build.
#
# ATENÇÃO (segurança): NÃO embarque uma chave de produção diretamente no app.
# Qualquer pessoa consegue extrair a chave de um bundle distribuído. Em
# produção, deixe EXPO_PUBLIC_ANTHROPIC_API_KEY vazia e aponte
# EXPO_PUBLIC_ANTHROPIC_BASE_URL para um backend/proxy seu que injeta a chave
# do lado do servidor. Veja COOKBOOK.md.

# Chave de API da Anthropic (use apenas em desenvolvimento local).
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# URL base da API. Padrão: API oficial. Em produção use a URL do seu proxy.
EXPO_PUBLIC_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Modelo a ser usado. Opcional (padrão: claude-sonnet-5).
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-sonnet-5
